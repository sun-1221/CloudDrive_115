{
  "name": "115-web-collector",
  "version": "0.1.0",
  "description": "115 网页端自动化接口采集器",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "collector": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "login": "tsx src/cli/index.ts login",
    "collect": "tsx src/cli/index.ts collect",
    "replay": "tsx src/cli/index.ts replay",
    "analyze": "tsx src/cli/index.ts analyze",
    "export": "tsx src/cli/index.ts export",
    "manual-capture": "tsx scripts/manual-capture.ts",
    "clean": "tsx scripts/clean-output.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
