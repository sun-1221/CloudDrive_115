# 默认自动处理行尾
* text=auto

# .NET 项目使用 CRLF
*.cs text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.json text eol=crlf

# 前端项目使用 LF
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf

# Shell 脚本使用 LF
*.sh text eol=lf

# Markdown
*.md text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
