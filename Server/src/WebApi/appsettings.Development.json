{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "115web-development",
    "Audience": "115web-development-client",
    "SigningKey": "115web-local-development-signing-key-change-me-32bytes"
  },
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/cloud-drive.development.db"
  },
  "Database": {
    "Type": "Sqlite"
  },
  "DataProtection": {
    "KeyStoragePath": "App_Data/keys"
  },
  "CloudDrive": {
    "CookieEncryptionKeyName": "CloudDrive.Cookie.v1",
    "WebApiBaseUrl": "https://webapi.115.com/",
    "MyApiBaseUrl": "https://my.115.com/",
    "VipApiBaseUrl": "https://vip.115.com/",
    "PayApiBaseUrl": "https://pay.115.com/",
    "OfflineApiBaseUrl": "https://clouddownload.115.com/web/",
    "CloudDriveFeatureEnabled": true,
    "OfflineSignatureEnabled": false
  }
}
